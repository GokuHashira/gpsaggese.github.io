# Slurm job scripts and job logs are local to Zaratan: never commit them.
slurm/
*.sbatch
slurm-*.out
logs/

# Generated data and checkpoints (cookiecutter-data-science: data/models are
# not versioned; checkpoints go to the Hugging Face Hub).
data/**
!data/**/
!data/**/.gitkeep
models/**
!models/.gitkeep
runs/
wandb/

# Python.
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Internal project log (the team story): local only, never committed.
references/project_log.md

# Planning documents: local only (team decision 2026-11-26).
references/project_plan_v2.md
references/mobile_deployment_plan.md

# Evaluation outputs: only the summaries (eval_metrics.json) are versioned.
results/**/pred_*.jsonl
results/**/gpu_trace.csv
results/**/*.partial.json
results/runs.jsonl

# Post-training samples and RFT pairs are large: only summary.json is versioned.
results/posttrain/**/samples.jsonl
results/posttrain/**/rft_pairs.jsonl

# E11 pairs are regenerated by e11_pairs.py; outputs of try_models.py are local.
results/posttrain/e11_pairs.jsonl
answers*.md

# GRPO runs made before the sampler/trainer fix (not valid results).
results/eval/grpo_q*/
